# Copy to backend/.env and fill in. backend/.env is gitignored.

# --- Database ---
# Matches the database that backend/scripts/load-dataset.sh creates.
DB_URL=jdbc:postgresql://localhost:5432/nba
# Which user depends on how PostgreSQL was installed:
#   - Homebrew (macOS): your macOS username. Run `whoami` to see it.
#     There is NO "postgres" user on a Homebrew install; using it fails with
#     FATAL: role "postgres" does not exist.
#   - Docker's official postgres image: postgres
#     (note: backend/scripts/load-dataset.sh only loads into a PostgreSQL on
#     this machine via its local socket, so with Docker load the CSV yourself
#     with psql's \copy over TCP)
DB_USERNAME=postgres
# Homebrew's local setup needs no password ("trust" auth), so leave this empty.
DB_PASSWORD=

# --- Admin credentials for write endpoints ---
# Required. The application refuses to start without these.
# Minimum 12 characters. Generate one with: openssl rand -base64 24
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- CORS ---
# Comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000
