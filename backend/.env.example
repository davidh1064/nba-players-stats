# Copy to backend/.env and fill in. backend/.env is gitignored.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/nba
DB_USERNAME=postgres
DB_PASSWORD=

# --- Admin credentials for write endpoints ---
# Required. The application refuses to start without these.
# Minimum 12 characters. Generate one with: openssl rand -base64 24
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- CORS ---
# Comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000
